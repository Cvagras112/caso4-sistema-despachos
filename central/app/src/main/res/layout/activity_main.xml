<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Central de Despacho"
            android:textColor="@color/texto_principal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Punto de control de despachos · Zonas: Centro, Alerce y Tepual"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <TextView style="@style/TituloSeccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conexión al broker MQTT" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Host del broker (ej. 10.0.2.2 o IP del PC)"
            android:inputType="textUri"
            android:textSize="16sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPuerto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Puerto (1883)"
            android:inputType="number"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvEstadoConexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Desconectado"
            android:textColor="@color/estado_pendiente"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Conectar" />

        <TextView style="@style/TituloSeccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Despachos" />

        <Button
            android:id="@+id/btnNuevoDespacho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevo despacho" />

        <Button
            android:id="@+id/btnVerDespachos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ver despachos" />

    </LinearLayout>
</ScrollView>
