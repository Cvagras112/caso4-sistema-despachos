<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle del despacho"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDetalleId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DES-001"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleEstado"
                style="@style/ChipEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip" />
        </LinearLayout>

        <TextView style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Destino" />

        <TextView style="@style/TextoValor"
            android:id="@+id/tvDetalleDestino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción" />

        <TextView style="@style/TextoValor"
            android:id="@+id/tvDetalleDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zona" />

        <TextView style="@style/TextoValor"
            android:id="@+id/tvDetalleZona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publicado" />

        <TextView style="@style/TextoValor"
            android:id="@+id/tvDetallePublicadoEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repartidor asignado" />

        <TextView style="@style/TextoValor"
            android:id="@+id/tvDetalleRepartidor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Última actualización" />

        <TextView style="@style/TextoValor"
            android:id="@+id/tvDetalleActualizadoEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial de estados" />

        <TextView style="@style/TextoValor"
            android:id="@+id/tvDetalleHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
