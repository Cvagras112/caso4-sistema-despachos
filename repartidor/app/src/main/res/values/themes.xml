<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Despachos" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorPrimaryDark">@color/primario_oscuro</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>
        <item name="android:colorBackground">@color/fondo</item>
    </style>

    <style name="TituloSeccion" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primario_oscuro</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>

    <style name="TextoEtiqueta" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextoValor" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="ChipEstado" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
